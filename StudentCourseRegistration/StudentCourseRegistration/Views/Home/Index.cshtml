@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">

    <h1 class="display-4">Student Course Registration System</h1>

    <p class="lead mt-3">
        Welcome to the Student Course Registration Portal.
    </p>

    <p>
        Register students, manage course information,
        and view registered student details.
    </p>

    <div class="mt-4">

        <a asp-controller="Student"
           asp-action="Create"
           class="btn btn-primary btn-lg">
            Register New Student
        </a>

        <a asp-controller="Student"
           asp-action="Index"
           class="btn btn-success btn-lg ms-2">
            View Student List
        </a>

    </div>

</div>
